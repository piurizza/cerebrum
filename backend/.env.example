APP_ENV=development
APP_NAME=Cerebrum
LOG_LEVEL=INFO
CEREBRUM_VAULT_PATH=../vault

# Optional: where the index and the accounts database live. Unset means
# <vault>/.cerebrum/. Move an existing auth.sqlite3 (with its -wal and -shm
# files) before setting CEREBRUM_AUTH_DB_PATH, or you get an empty accounts
# database and AUTH_SETUP_TOKEN works again.
# Keep these apart from the Docker data folder (../data), which a running
# stack uses. Tests always ignore both variables.
# CEREBRUM_INDEX_PATH=../data/dev/index.sqlite3
# CEREBRUM_AUTH_DB_PATH=../data/dev/auth.sqlite3

# Optional: serve the vault without writing to it. Needs both paths above
# set outside the vault.
# CEREBRUM_VAULT_READ_ONLY=true
CORS_ORIGINS=["http://localhost:5173"]

# Required; no default. Generate each with: openssl rand -hex 32
AUTH_JWT_SECRET=
AUTH_SETUP_TOKEN=

# Vault-relative folders for "Today" and the template picker, served to
# the web app by GET /api/vault-settings. Optional; these are the defaults.
# CEREBRUM_DAILY_NOTE_FOLDER=daily
# CEREBRUM_TEMPLATES_FOLDER=templates

# Link form written by the editor's [[ picker and asked of MCP agents:
# markdown (default) or wikilink. Both are always read.
# CEREBRUM_LINK_FORMAT=markdown

# Optional: sign in with an OpenID Connect provider (Keycloak, Authentik,
# Pocket ID, Google, ...). Set the issuer, client id and secret together, or
# none. The callback needs the nginx proxy of the Docker stack; it does not
# work through the Vite dev server's proxy. See
# https://piurizza.github.io/cerebrum/running/identity-provider/
# OIDC_ISSUER=https://auth.example.com/realms/home
# OIDC_CLIENT_ID=cerebrum
# OIDC_CLIENT_SECRET=
# OIDC_PROVIDER_NAME=Keycloak
# Members of this provider group are admins (synced at each provider sign-in).
# OIDC_ADMIN_GROUP=cerebrum-admins
# OIDC_GROUPS_CLAIM=groups
# Make the provider the way in: invites are redeemed through it, and linked
# non-admins can't use a password any more. Admins always can.
# AUTH_PASSWORD_LOGIN=false
