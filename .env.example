# docker-compose configuration (see docker-compose.yml)
CEREBRUM_VAULT_HOST_PATH=./vault
CEREBRUM_PORT=7811

# User and group the backend runs as -- set to the owner of the vault
# directory above (`id -u` / `id -g`) if that isn't 1000. On native Linux
# Docker, notes the backend creates are owned by this user on the host.
# CEREBRUM_UID=1000
# CEREBRUM_GID=1000

# HTTPS port for the self-signed cert nginx generates on first start (see
# frontend/docker-entrypoint.sh). Offline mode needs this -- a service
# worker only registers in a secure context (HTTPS, or literal
# "localhost"), which the plain-HTTP CEREBRUM_PORT above doesn't satisfy
# for LAN/phone access.
CEREBRUM_HTTPS_PORT=7812

# Which network interface the two ports above listen on. 127.0.0.1 (the
# default) means only this machine. To use Cerebrum from your phone or other
# computers, set 0.0.0.0 (every network) or this machine's LAN address, and
# set CEREBRUM_TLS_SAN below too. Plain HTTP is then visible to everyone on
# that network, so prefer the HTTPS port or Tailscale there.
CEREBRUM_BIND_ADDRESS=127.0.0.1

# Extra Subject Alternative Names for that cert, comma-separated, e.g.
# "IP:192.168.1.14" for your LAN IP or "DNS:cerebrum.local" for a hostname.
# Needed for the browser to accept the cert (after a one-time manual trust
# step) when reached by anything other than localhost/127.0.0.1. Left
# unset by default -- set this to your own LAN IP/hostname before relying
# on offline mode from a phone or another device.
CEREBRUM_TLS_SAN=

# Vault-relative folder daily notes are created under (see the "Today"
# sidebar button). Read by the backend at startup -- changing it needs
# only `docker compose up -d` (a restart), not a rebuild. Formerly
# VITE_DAILY_NOTE_FOLDER, which is still honored as a fallback.
CEREBRUM_DAILY_NOTE_FOLDER=daily

# Vault-relative folder note templates live in (see the "+ New note"
# template picker). Read by the backend at startup, same as above;
# formerly VITE_TEMPLATES_FOLDER. If your vault already has an unrelated
# folder with this name, set this to something else before enabling the
# feature -- every note under it becomes a selectable template.
CEREBRUM_TEMPLATES_FOLDER=templates

# Required by the backend container (docker-compose.yml fails fast via
# `:?` if either is unset). Generate each with: openssl rand -hex 32
AUTH_JWT_SECRET=
AUTH_SETUP_TOKEN=

# Optional: force polling for filesystem change detection instead of
# inotify, needed on bind-mount/network filesystems where native events
# are unreliable (Docker Desktop on macOS/Windows, NFS).
# WATCHFILES_FORCE_POLLING=1
