# Python (backend)
.env
.venv/
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Node (frontend)
node_modules/
frontend/dist/
frontend/.env
frontend/dev-dist/

# Playwright (local-only mobile E2E — not part of the CI gate)
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/e2e/.auth/
# defensive: a stray run with cwd at the repo root drops these here
/test-results/
/playwright-report/

# Node + Rust (desktop) — node_modules/ above already covers
# desktop/node_modules/; src-tauri/ has its own nested .gitignore for the
# Cargo build target
desktop/dist/
desktop/.env

# Disposable bridge artifact between the backend's OpenAPI schema export
# and the frontend's type generation (see Makefile's generate-api-types) —
# regenerated on demand, never a source of truth
/openapi.json

# Vault data (user notes + derived index) — never commit personal notes
/vault/*
!/vault/.gitkeep

# Agent planning artifacts (brainstorm/plan docs) — local working notes, not committed
/docs/plans/

# `tailscale cert` writes to the current directory by default (README
# "Install on a phone" section) -- these are private key material and must
# never be committed. Belt-and-suspenders: the real copies belong in the
# frontend's cert volume (/etc/nginx/certs/cerebrum.{crt,key}), not here.
*.ts.net.crt
*.ts.net.key
*.pem
