# Only needed if not going through the Vite dev proxy / nginx proxy
# (see vite.config.ts and nginx.conf, which both proxy /api by default).
VITE_API_BASE_URL=

# Vault-relative folder daily notes are created under (see the "Today"
# sidebar button). Build-time only -- changing this on a deployed
# instance needs a frontend rebuild, not just an env edit.
VITE_DAILY_NOTE_FOLDER=daily

# Vault-relative folder note templates live in (see the "+ New note"
# template picker). Build-time only -- changing this on a deployed
# instance needs a frontend rebuild, not just an env edit. If your vault
# already has an unrelated folder with this name, pick a different value
# before enabling this feature -- every note under it becomes a
# selectable template.
VITE_TEMPLATES_FOLDER=templates
