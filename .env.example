# docker-compose configuration (see docker-compose.yml)
CEREBRUM_VAULT_HOST_PATH=./vault
CEREBRUM_PORT=8080

# Vault-relative folder daily notes are created under (see the "Today"
# sidebar button). Baked into the frontend image at build time -- changing
# this on a deployed instance needs `docker compose build/up frontend`,
# not just an edit here.
VITE_DAILY_NOTE_FOLDER=daily

# Required by the backend container (docker-compose.yml fails fast via
# `:?` if either is unset). Generate each with: openssl rand -hex 32
AUTH_JWT_SECRET=
AUTH_SETUP_TOKEN=

# Optional: force polling for filesystem change detection instead of
# inotify, needed on bind-mount/network filesystems where native events
# are unreliable (Docker Desktop on macOS/Windows, NFS).
# WATCHFILES_FORCE_POLLING=1
