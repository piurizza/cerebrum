# Only needed if not going through the Vite dev proxy / nginx proxy
# (see vite.config.ts and nginx.conf, which both proxy /api by default).
VITE_API_BASE_URL=

# Vault-relative folder daily notes are created under (see the "Today"
# sidebar button). Build-time only -- changing this on a deployed
# instance needs a frontend rebuild, not just an env edit.
VITE_DAILY_NOTE_FOLDER=daily
